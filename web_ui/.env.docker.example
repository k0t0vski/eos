# Database
DATABASE_URL=postgresql://user:password@host.docker.internal:5432/eos

# Orchestrator API
ORCHESTRATOR_API_URL=http://host.docker.internal:8070/api

# EOS user directory
USER_DIR=/path/to/user/directory

# S3
EOS_S3_BUCKET=eos
EOS_S3_ENDPOINT_URL=http://host.docker.internal:8333
EOS_S3_ACCESS_KEY_ID=user
EOS_S3_SECRET_ACCESS_KEY=password
# AWS S3: leave EOS_S3_ENDPOINT_URL unset (or use https://s3.<region>.amazonaws.com), set EOS_S3_REGION, and leave both
# keys empty to use the AWS credential chain (e.g. an EC2 instance role)
# EOS_S3_REGION=eu-central-1
# Path-style addressing; the default is true when EOS_S3_ENDPOINT_URL is set, otherwise false
# EOS_S3_FORCE_PATH_STYLE=true

# Web UI
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Zitadel OIDC)
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_ISSUER=https://auth.example.org
AUTH_CLIENT_ID=
AUTH_ORG_ID=
AUTH_PROJECT_ID=
AUTH_PAT=
AUTH_INTROSPECTION_CLIENT_ID=
AUTH_INTROSPECTION_CLIENT_SECRET=
